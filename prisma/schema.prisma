generator client {
 provider="prisma-client-js"
}

datasource db {
 provider="postgresql"
 url=env("DATABASE_URL")
}

model Group {
 id Int @id @default(autoincrement())
 name String
 slug String @unique
 platform String
 category String
 description String?
 memberCount Int @default(0)
 qualityScore Int @default(0)
 inviteLink String
 createdAt DateTime @default(now())
}